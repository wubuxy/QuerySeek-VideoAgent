# =============================================================================
# QuerySeek-VideoAgent 环境变量示例
# 复制为 .env 并填写；.env 已被 .gitignore 排除，绝不提交。
# 所有密钥只通过环境变量读取，代码不会打印密钥内容。
# ⚠️ 本文件（.env.example）会随仓库提交，只允许占位符，绝不填写真实密钥。
# =============================================================================

# --- VLM（兼容 OpenAI Chat Completions 的视觉模型服务）-----------------------
# 不设置时 CLI 可用 --mock 以确定性 Mock 运行完整流程（无密钥/离线可测）。
VLM_API_KEY=
VLM_BASE_URL=https://api.openai.com/v1
VLM_MODEL=

# --- 本地 ASR（可选；默认顺序：用户 SRT -> faster-whisper CPU -> 禁用）-------
ASR_MODEL=small
ASR_COMPUTE_TYPE=int8

# --- 路径覆盖（可选，默认取 configs/default.yaml 中的相对路径）---------------
# QUERYSEEK_CACHE_ROOT=data/cache
# QUERYSEEK_OUTPUT_ROOT=outputs
# QUERYSEEK_DATA_ROOT=data

# --- OpenCLIP 权重下载（可选；HF Hub 未登录时可能限速）------------------------
# HF_TOKEN=
